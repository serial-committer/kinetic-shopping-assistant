{
  "name": "kinetic-shopping-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "A small shopping assistant over a real fashion catalog: a chat model reads the request, code does every exact step.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "deps": "node tools/install-deps.ts",
    "start": "node server/main.ts",
    "dev": "node tools/dev.ts",
    "clean-catalog": "node tools/clean-catalog.ts",
    "embed-catalog": "node tools/embed-catalog.ts",
    "search-check": "node tools/search-check.ts",
    "slip-test": "node tools/slip-test.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "openai": "7.43.0",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
