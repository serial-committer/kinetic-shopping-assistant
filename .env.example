# Kinetic Shopping Assistant settings. Copy this file to .env and fill in what you use.
# Every value is optional. With no chat provider set up, the app runs in search-only mode.

# Ports for the API server and the web page
SERVER_PORT=9500
WEB_PORT=9519

# Chat providers. The dropdown in the app lists only the ones set up here.
# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Offline, free, runs on your own machine: install Ollama, run `ollama pull qwen2.5:7b`, then uncomment the next line.
# OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Logging: TRACE, DEBUG, INFO, WARN, ERROR or OFF
LOG_LEVEL=INFO
# true shows a small debug button in the app that opens the server logs
DEBUG_PANEL=false

# Optional: install packages into this shared folder and link node_modules to it (npm run deps).
# Leave it empty to install the usual way with npm ci.
SHARED_NODE_MODULES=
